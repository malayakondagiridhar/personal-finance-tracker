# Root-level environment template
# Copy to .env for local docker/dev usage.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PersonalFinanceTrackerDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True
DatabaseProvider=SqlServer

# JWT (Phase 1)
Auth__Issuer=personal-finance-tracker
Auth__Audience=personal-finance-tracker-api
Auth__SigningKey=replace-with-min-32-char-secret

# CORS (Phase 4)
Cors__AllowedOrigins=http://localhost:5173

# Firebase Auth (P0)
# Frontend (Vite)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Backend token validation target
Auth__FirebaseProjectId=replace-me

# Frontend API routing
# Use explicit API base URL in staging/prod when frontend and API are on different hosts.
# Example: https://api.example.com/api/v1
VITE_API_BASE_URL=

# API version prefix (used for relative routing/proxy)
VITE_API_VERSION_PREFIX=/api/v1

# Dev-only Vite proxy backend target
# Use HTTPS endpoint to avoid redirect hops (307) that can strip bearer headers.
# Default if omitted: https://localhost:7121
VITE_API_PROXY_TARGET=https://localhost:7121
